---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`pointer-events-none fixed inset-0 -z-10 ${className}`} aria-hidden="true">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style="background-image: url('/images/travertine-marble.jpg');"
  >
  </div>
  <div class="absolute inset-0 bg-white/75"></div>
</div>
