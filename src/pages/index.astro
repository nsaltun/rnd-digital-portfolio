---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import QRCode from '../components/QRCode.astro';
import { contact } from '../data/contact';

// Bir proje dosyası henüz eklenmediyse (boş/placeholder PDF), indirme butonunu gizle.
const hasRealFile = (publicPath: string) => {
  try {
    const fullPath = path.join(process.cwd(), 'public', publicPath);
    return fs.statSync(fullPath).size > 0;
  } catch {
    return false;
  }
};

const projects = [
  {
    title: "Rezidans Bloğu I",
    location: "Antalya, TR",
    coordinates: "36.8969° N, 30.7133° E",
    year: "2024",
    images: [
      "/images/rezidans-1.jpg",
      "/images/rezidans-1-2.jpg",
      "/images/rezidans-1-3.jpg",
      "/images/rezidans-1-4.jpg",
      "/images/rezidans-1-5.jpg",
      "/images/rezidans-1-plan.jpg"
    ],
    fullImages: [
      "/images/full/rezidans-1.jpg",
      "/images/full/rezidans-1-2.jpg",
      "/images/full/rezidans-1-3.jpg",
      "/images/full/rezidans-1-4.jpg",
      "/images/full/rezidans-1-5.jpg",
      "/images/full/rezidans-1-plan.jpg"
    ],
    pdf: "/downloads/rezidans-1.pdf"
  },
  {
    title: "Havuzlu Rezidans Kompleksi",
    location: "Antalya, TR",
    coordinates: "36.9081° N, 30.6956° E",
    year: "2022",
    images: ["/images/rezidans-kompleks.jpg"],
    fullImages: ["/images/full/rezidans-kompleks.jpg"],
    pdf: "/downloads/rezidans-kompleks.pdf"
  },
  {
    title: "Köşe Bina Tasarımı",
    location: "Antalya, TR",
    coordinates: "36.8850° N, 30.7061° E",
    year: "2021",
    images: ["/images/kose-bina.jpg"],
    fullImages: ["/images/full/kose-bina.jpg"],
    pdf: "/downloads/kose-bina.pdf"
  },
  {
    title: "İç Mekan Tasarımı",
    location: "Antalya, TR",
    coordinates: "36.8969° N, 30.7133° E",
    year: "2025",
    images: [
      "/images/ic-mekan-mutfak.jpg",
      "/images/ic-mekan-mutfak-2.jpg",
      "/images/ic-mekan-banyo.jpg"
    ],
    fullImages: [
      "/images/full/ic-mekan-mutfak.jpg",
      "/images/full/ic-mekan-mutfak-2.jpg",
      "/images/full/ic-mekan-banyo.jpg"
    ],
    pdf: "/downloads/ic-mekan.pdf"
  }
].map((project) => ({ ...project, hasPdf: hasRealFile(project.pdf) }));
---

<Layout title={`${contact.title} ${contact.fullName} | Dijital Portfolyo`}>
  <main class="max-w-6xl mx-auto px-6 py-24 text-[#111111]">
    
    <!-- 1. HERO / GİRİŞ — Mobil: ekranı ikiye bölen, kaydırdıkça solan banner -->
    <div class="md:hidden">
      <div id="mobile-banner" class="h-[50vh] flex items-center justify-center" style="will-change: opacity;">
        <div class="flex items-end gap-3" style="filter: drop-shadow(-5px 8px 5px rgba(17,17,17,0.25));" aria-hidden="true">
          <span class="font-mono-arch leading-none text-[#111111] text-[46vw]" style="opacity: 0.9;">R</span>
          <span class="mark-dot bg-[#111111] w-[7vw] h-[7vw] mb-[7vw]" style="opacity: 0.55;"></span>
        </div>
      </div>
      <div class="min-h-[50vh] flex flex-col justify-center pb-16 mb-32 border-b border-[#111111]/10 relative">
        <h1 class="text-6xl font-light tracking-tighter leading-none mb-6">
          MİMAR <br/> RÜMEYSA NUR ALTUN
        </h1>
        <p class="text-xl font-light max-w-xl text-[#111111]/70 leading-relaxed">
          Form, işlevi takip etmez; form ve işlev mimari bir bütünlük içinde var olur.
        </p>
        <div class="absolute left-0 -bottom-2.5 h-10 w-[1px] bg-[#111111]/40">
          <span class="absolute -top-1 left-1/2 -translate-x-1/2 h-1.5 w-1.5 rounded-full border border-[#111111]/40"></span>
        </div>
      </div>
    </div>

    <!-- 1. HERO / GİRİŞ — Masaüstü -->
    <header class="hidden md:flex min-h-[42vh] flex-col justify-end mb-32 border-b border-[#111111]/10 pb-12 relative">
      <div
        class="flex items-end self-start gap-5 mb-8"
        style="filter: drop-shadow(-6px 10px 6px rgba(17,17,17,0.25));"
        aria-hidden="true"
      >
        <span class="font-mono-arch leading-none text-[#111111] text-[216px]" style="opacity: 0.9;">R</span>
        <span class="mark-dot bg-[#111111] w-[34px] h-[34px] mb-[34px]" style="opacity: 0.55;"></span>
      </div>
      <h1 class="text-8xl font-light tracking-tighter leading-none mb-6">
        MİMAR <br/> RÜMEYSA NUR ALTUN
      </h1>
      <p class="text-2xl font-light max-w-xl text-[#111111]/70 leading-relaxed">
        Form, işlevi takip etmez; form ve işlev mimari bir bütünlük içinde var olur.
      </p>
      <!-- Teknik çizim referans işareti: yatay ayraçla kesişen dikey işaret, ucunda nirengi noktası -->
      <div class="absolute left-0 -bottom-2.5 h-10 w-[1px] bg-[#111111]/40">
        <span class="absolute -top-1 left-1/2 -translate-x-1/2 h-1.5 w-1.5 rounded-full border border-[#111111]/40"></span>
      </div>
    </header>

    <!-- 2. PORTFOLYO (CAD HOVER EFEKTİ) -->
    <section class="mb-40">
      <h2 class="text-xs uppercase tracking-widest text-[#111111]/40 mb-16 font-mono-arch">— SEÇİLMİŞ PROJELER</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-16 gap-y-32 items-start">
        {projects.map((project, index) => (
          <div class={`md:col-span-6 ${index % 2 === 0 ? 'md:mt-0' : 'md:mt-32'} group/item relative`}>

            <div
              class="project-gallery relative overflow-hidden bg-[#F5F5F7] aspect-[4/3] mb-6 cursor-zoom-in"
              data-full-images={JSON.stringify(project.fullImages)}
              data-title={project.title}
            >
              <!-- CAD Çizgileri -->
              <span class="absolute top-0 left-0 w-0 h-[1px] bg-[#111111]/40 transition-all duration-500 group-hover/item:w-full z-10"></span>
              <span class="absolute top-0 left-0 h-0 w-[1px] bg-[#111111]/40 transition-all duration-500 group-hover/item:h-full z-10"></span>

              {project.images.map((src, i) => (
                <img
                  src={src}
                  alt={`${project.title} — ${project.location}, mimari tasarım görseli ${i + 1}/${project.images.length}`}
                  loading="lazy"
                  class={`gallery-frame absolute inset-0 w-full h-full object-cover grayscale contrast-[1.1] transition-all duration-700 group-hover/item:grayscale-0 group-hover/item:scale-105 ${i === 0 ? 'is-active' : ''}`}
                />
              ))}

              {project.images.length > 1 && (
                <div class="absolute bottom-4 right-4 z-10 flex gap-1.5 opacity-0 transition-opacity duration-500 group-hover/item:opacity-100">
                  {project.images.map((_, i) => (
                    <span class={`gallery-dot h-1.5 w-1.5 rounded-full ring-1 ring-[#FAF9F6]/80 transition-all duration-300 ${i === 0 ? 'is-active bg-[#FAF9F6] scale-125' : 'bg-[#FAF9F6]/40'}`}></span>
                  ))}
                </div>
              )}

              <div class="absolute bottom-4 left-4 opacity-0 transition-opacity duration-500 group-hover/item:opacity-100 bg-[#FAF9F6]/90 backdrop-blur-sm px-3 py-1.5 text-[10px] tracking-widest uppercase font-mono-arch z-10 border border-[#111111]/10">
                {project.coordinates} — {project.year}
              </div>
            </div>

            <div class="flex justify-between items-end border-b border-[#111111]/10 pb-4">
              <div>
                <h3 class="text-2xl font-light tracking-tight">{project.title}</h3>
                <p class="text-xs text-[#111111]/50 uppercase tracking-wider mt-1 font-mono-arch">{project.location}</p>
              </div>
              
              <!-- Client-side PDF İndirme: dosya eklenene kadar buton görünmez -->
              {project.hasPdf && (
                <a
                  href={project.pdf}
                  download
                  class="text-[11px] uppercase tracking-widest border border-[#111111] px-4 py-2 hover:bg-[#111111] hover:text-white transition-colors duration-300 font-mono-arch"
                >
                  PROJEYİ İNDİR ↓
                </a>
              )}
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- 3. ÖZGEÇMİŞ -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-40 border-t border-[#111111]/10 pt-16">
      <div class="md:col-span-4">
        <h2 class="text-xs uppercase tracking-widest text-[#111111]/40 font-mono-arch">— ÖZGEÇMİŞ & EĞİTİM</h2>
      </div>
      <div class="md:col-span-8 font-light text-lg space-y-6 text-[#111111]/80">
        <p class="leading-relaxed">Antalya merkezli çalışmalarını sürdüren Mimar Rümeysa Nur Altun, Antalya Bilim Üniversitesi Mimarlık ve Antalya Bilişim Üniversitesi İnşaat Mühendisliği bölümlerinden çift anadal derecesiyle mezun oldu. Yapısal bütünlük ile mekânsal deneyimi aynı disiplin içinde ele alan, malzeme ve strüktürün mimari forma dönüştüğü projeler üretiyor.</p>

        <div class="pt-6 border-t border-[#111111]/5 text-sm space-y-4 font-mono-arch">
          <div class="flex justify-between border-b border-[#111111]/5 pb-2">
            <span class="text-[#111111]/50">2015 — 2020</span>
            <span class="text-right">Lisans — Antalya Bilim Üniversitesi, Mimarlık</span>
          </div>
          <div class="flex justify-between border-b border-[#111111]/5 pb-2">
            <span class="text-[#111111]/50">2015 — 2020</span>
            <span class="text-right">Çift Anadal — Antalya Bilişim Üniversitesi, İnşaat Mühendisliği</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DIJITAL KARTVIZIT & ILETISIM -->
    <footer class="border-t-2 border-[#111111] pt-12 flex flex-col md:flex-row justify-between items-start gap-12">
      <div>
        <h2 class="text-xs uppercase tracking-widest text-[#111111]/40 mb-6 font-mono-arch">— İLETİŞİM</h2>
        <div class="space-y-3 text-3xl font-light tracking-tighter">
          <p><a href={`mailto:${contact.email}`} class="hover:underline break-all">{contact.email}</a></p>
        </div>
        <a
          href="/contact.vcf"
          download
          class="inline-block mt-6 text-[11px] uppercase tracking-widest border border-[#111111] px-4 py-2 hover:bg-[#111111] hover:text-white transition-colors duration-300 font-mono-arch"
        >
          REHBERE EKLE ↓
        </a>
      </div>

      <div class="flex flex-col sm:flex-row gap-8 items-start sm:items-center w-full md:w-auto justify-between">
        <div class="flex gap-6 text-xs uppercase tracking-widest font-mono-arch">
          <a href={contact.instagram} target="_blank" rel="noopener noreferrer" class="hover:underline">Instagram</a>
        </div>
        <a
          href={contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="w-24 h-24 bg-[#F5F5F7] border border-[#111111]/10 flex items-center justify-center p-2"
          aria-label="Instagram QR kodu"
        >
          <QRCode class="w-full h-full" />
        </a>
      </div>
    </footer>

  </main>

  <!-- LIGHTBOX -->
  <div id="lightbox" class="fixed inset-0 z-50 items-center justify-center bg-[#111111]/95 backdrop-blur-sm p-6" role="dialog" aria-modal="true">
    <button
      id="lightbox-close"
      aria-label="Kapat"
      class="absolute top-2 right-2 z-20 flex items-center justify-center w-16 h-16 text-[#FAF9F6] text-5xl font-light leading-none hover:opacity-60 transition-opacity"
    >
      &times;
    </button>
    <button
      id="lightbox-prev"
      aria-label="Önceki görsel"
      class="absolute inset-y-0 left-0 z-10 flex items-center justify-center w-[max(4.5rem,calc(50%-36rem))] text-[#FAF9F6] text-6xl md:text-7xl font-light hover:bg-white/5 active:opacity-60 transition-colors"
    >
      &#8249;
    </button>
    <button
      id="lightbox-next"
      aria-label="Sonraki görsel"
      class="absolute inset-y-0 right-0 z-10 flex items-center justify-center w-[max(4.5rem,calc(50%-36rem))] text-[#FAF9F6] text-6xl md:text-7xl font-light hover:bg-white/5 active:opacity-60 transition-colors"
    >
      &#8250;
    </button>

    <div class="max-w-6xl w-full flex flex-col items-center gap-4">
      <div id="lightbox-stage" class="relative flex items-center justify-center w-full h-[74vh] overflow-hidden">
        <span id="lightbox-loader" class="lb-loader hidden"></span>
        <img id="lightbox-image" src="" alt="" class="absolute inset-0 w-full h-full object-contain select-none opacity-0" />
        <img id="lightbox-image-2" src="" alt="" class="absolute inset-0 w-full h-full object-contain select-none opacity-0" />
      </div>
      <p id="lightbox-caption" class="text-[#FAF9F6]/70 text-[11px] uppercase tracking-widest font-mono-arch"></p>
    </div>
  </div>
</Layout>

<script>
  // Mobil: giriş banner'ı aşağı kaydırıldıkça soluklaşarak kaybolur.
  // requestAnimationFrame ile sınırlanıyor — yoksa hızlı kaydırmada/iOS'un
  // "rubber-band" geri sekmesinde saniyede onlarca stil güncellemesi titremeye yol açıyor.
  const mobileBanner = document.getElementById('mobile-banner');
  if (mobileBanner) {
    const fadeDistance = window.innerHeight * 0.28;
    let ticking = false;
    const updateBannerFade = () => {
      const progress = Math.min(Math.max(window.scrollY / fadeDistance, 0), 1);
      mobileBanner.style.opacity = String(1 - progress);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateBannerFade);
      },
      { passive: true }
    );
    updateBannerFade();
  }

  const HOVER_INTERVAL = 4000;

  document.querySelectorAll<HTMLElement>('.project-gallery').forEach((gallery) => {
    const frames = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-frame'));
    const dots = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-dot'));
    if (frames.length <= 1) return;

    let active = 0;
    let timer: number | undefined;

    const setActive = (next: number) => {
      frames[active].classList.remove('is-active');
      dots[active]?.classList.remove('is-active', 'bg-[#FAF9F6]', 'scale-125');
      dots[active]?.classList.add('bg-[#FAF9F6]/40');

      active = next;
      frames[active].classList.add('is-active');
      dots[active]?.classList.add('is-active', 'bg-[#FAF9F6]', 'scale-125');
      dots[active]?.classList.remove('bg-[#FAF9F6]/40');
    };

    gallery.addEventListener('mouseenter', () => {
      timer = window.setInterval(() => setActive((active + 1) % frames.length), HOVER_INTERVAL);
    });

    gallery.addEventListener('mouseleave', () => {
      if (timer) window.clearInterval(timer);
      setActive(0);
    });
  });

  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxImage2 = document.getElementById('lightbox-image-2') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption') as HTMLElement;
  const lightboxLoader = document.getElementById('lightbox-loader') as HTMLElement;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;

  // Arka planda tüm galeri görsellerini önden yükle — lightbox'ta anında geçiş için.
  const preloaded = new Set<string>();
  const preloadImage = (src: string) =>
    new Promise<void>((resolve) => {
      if (preloaded.has(src)) return resolve();
      const img = new Image();
      img.onload = img.onerror = () => {
        preloaded.add(src);
        resolve();
      };
      img.src = src;
    });

  const allFullImages = Array.from(document.querySelectorAll<HTMLElement>('.project-gallery')).flatMap(
    (g) => JSON.parse(g.dataset.fullImages || '[]') as string[]
  );

  const preloadQueue = async (urls: string[], concurrency = 2) => {
    let i = 0;
    const workers = Array.from({ length: concurrency }, async () => {
      while (i < urls.length) {
        const url = urls[i++];
        await preloadImage(url);
      }
    });
    await Promise.all(workers);
  };

  const startBackgroundPreload = () => {
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? (window as any).requestIdleCallback(cb) : setTimeout(cb, 1200);
    idle(() => preloadQueue(allFullImages));
  };

  if (document.readyState === 'complete') startBackgroundPreload();
  else window.addEventListener('load', startBackgroundPreload);

  let currentImages: string[] = [];
  let currentIndex = 0;
  let currentTitle = '';
  let isAnimating = false;

  // frontImg = şu an görünen, backImg = bir sonraki geçişte içeri girecek olan.
  let frontImg = lightboxImage;
  let backImg = lightboxImage2;

  const SLIDE_MS = 320;
  const SLIDE_EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const BOUNCE_DIST = 26;

  const forceReflow = (el: HTMLElement) => void el.offsetWidth;

  const updateNavUI = () => {
    lightboxCaption.textContent =
      currentImages.length > 1 ? `${currentTitle} — ${currentIndex + 1}/${currentImages.length}` : currentTitle;
    const showNav = currentImages.length > 1;
    prevBtn.style.display = showNav ? '' : 'none';
    nextBtn.style.display = showNav ? '' : 'none';
  };

  // İlk açılış: tek görsel, yerinde belirir.
  const openImage = (src: string) => {
    const reveal = () => {
      preloaded.add(src);
      lightboxLoader.classList.add('hidden');
      frontImg.style.transition = 'opacity 280ms ease';
      forceReflow(frontImg);
      frontImg.classList.remove('opacity-0');
    };
    frontImg.style.transition = 'none';
    frontImg.style.transform = 'translateX(0)';
    frontImg.classList.add('opacity-0');
    frontImg.src = src;
    if (preloaded.has(src)) requestAnimationFrame(reveal);
    else {
      lightboxLoader.classList.remove('hidden');
      frontImg.onload = reveal;
    }
  };

  // direction: 1 = sonraki, -1 = önceki — iki görsel aynı anda, birbirinin yerini alarak kayar.
  const slideTo = (src: string, direction: number) => {
    const run = () => {
      preloaded.add(src);
      lightboxLoader.classList.add('hidden');
      isAnimating = true;

      backImg.style.transition = 'none';
      backImg.style.transform = `translateX(${direction > 0 ? '100%' : '-100%'})`;
      backImg.classList.remove('opacity-0');
      forceReflow(backImg);

      requestAnimationFrame(() => {
        const anim = `transform ${SLIDE_MS}ms ${SLIDE_EASE}`;
        frontImg.style.transition = anim;
        backImg.style.transition = anim;
        frontImg.style.transform = `translateX(${direction > 0 ? '-100%' : '100%'})`;
        backImg.style.transform = 'translateX(0)';
      });

      window.setTimeout(() => {
        frontImg.classList.add('opacity-0');
        [frontImg, backImg] = [backImg, frontImg];
        isAnimating = false;
      }, SLIDE_MS + 20);
    };

    backImg.src = src;
    if (preloaded.has(src)) {
      run();
    } else {
      lightboxLoader.classList.remove('hidden');
      backImg.onload = run;
    }
  };

  // Tek görselli galerilerde kaydırma denemesine hafif bir "esneme" tepkisi.
  const bounceImage = (direction: number) => {
    const el = frontImg;
    const offset = direction > 0 ? -BOUNCE_DIST : BOUNCE_DIST;
    el.style.transition = 'transform 140ms ease-out';
    el.style.transform = `translateX(${offset}px)`;
    window.setTimeout(() => {
      el.style.transition = 'transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1)';
      el.style.transform = 'translateX(0)';
    }, 140);
  };

  const showImage = (isFirstOpen = false, direction = 0) => {
    updateNavUI();
    const src = currentImages[currentIndex];
    if (isFirstOpen) openImage(src);
    else slideTo(src, direction);
  };

  // iOS Safari'de sade `overflow:hidden` arka plan scroll'unu tam engellemiyor.
  let lockedScrollY = 0;
  const lockScroll = () => {
    lockedScrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${lockedScrollY}px`;
    document.body.style.width = '100%';
  };
  const unlockScroll = () => {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    window.scrollTo(0, lockedScrollY);
  };

  // Telefonun "geri" tuşu, lightbox'ı kapatsın; siteden çıkmasın.
  let lightboxHistoryPushed = false;

  const openLightbox = (images: string[], title: string, startIndex: number) => {
    currentImages = images;
    currentTitle = title;
    currentIndex = startIndex;
    showImage(true);
    lightbox.classList.add('is-open');
    lockScroll();
    history.pushState({ lightbox: true }, '', location.href);
    lightboxHistoryPushed = true;
  };

  const closeLightbox = (fromPopstate = false) => {
    if (!lightbox.classList.contains('is-open')) return;
    lightbox.classList.remove('is-open');
    unlockScroll();
    if (lightboxHistoryPushed) {
      lightboxHistoryPushed = false;
      if (!fromPopstate) history.back();
    }
  };

  window.addEventListener('popstate', () => closeLightbox(true));

  const goPrev = () => {
    if (isAnimating || currentImages.length <= 1) return;
    currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
    showImage(false, -1);
  };
  const goNext = () => {
    if (isAnimating || currentImages.length <= 1) return;
    currentIndex = (currentIndex + 1) % currentImages.length;
    showImage(false, 1);
  };

  document.querySelectorAll<HTMLElement>('.project-gallery').forEach((gallery) => {
    gallery.addEventListener('click', () => {
      const images: string[] = JSON.parse(gallery.dataset.fullImages || '[]');
      const title = gallery.dataset.title || '';
      const frames = Array.from(gallery.querySelectorAll('.gallery-frame'));
      const activeFrame = gallery.querySelector('.gallery-frame.is-active');
      const startIndex = activeFrame ? frames.indexOf(activeFrame) : 0;
      openLightbox(images, title, startIndex);
    });
  });

  closeBtn.addEventListener('click', () => closeLightbox());
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  prevBtn.addEventListener('click', goPrev);
  nextBtn.addEventListener('click', goNext);

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') goPrev();
    if (e.key === 'ArrowRight') goNext();
  });

  // Dokunmatikte kaydırarak geçiş — pinch-zoom'a müdahale etmemek için sadece
  // yatay hareketi ölçüyoruz, preventDefault çağırmıyoruz.
  let touchStartX = 0;
  let touchStartY = 0;
  lightbox.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    },
    { passive: true }
  );
  lightbox.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;

      // Basit bir dokunuş (kaydırma değil) — kapatma tuşuna veya arka plana
      // dokunulduysa, tarayıcının click sentezini beklemeden hemen kapat.
      if (Math.abs(dx) < 10 && Math.abs(dy) < 10) {
        const target = e.target as HTMLElement;
        if (target === closeBtn || target.closest('#lightbox-close') || target === lightbox) {
          e.preventDefault();
          closeLightbox();
        }
        return;
      }

      if (isAnimating) return;
      if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      const direction = dx < 0 ? 1 : -1;
      if (currentImages.length <= 1) {
        bounceImage(direction);
        return;
      }
      if (direction > 0) goNext();
      else goPrev();
    },
    { passive: false }
  );
</script>