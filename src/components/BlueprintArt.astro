---
interface Props {
  variant: "residence" | "villa";
  seed?: number;
  class?: string;
}

const { variant, seed = 0, class: className = "" } = Astro.props;
const offset = (seed % 3) * 6;

const blocks =
  variant === "residence"
    ? [0, 1, 2].map((i) => {
        const x = 40 + i * 110;
        const h = 140 + ((i + seed) % 2) * 40;
        const y = 260 - h;
        const floors = Math.floor(h / 20);
        return { x, y, h, floors };
      })
    : [];
---

<svg
  class={className}
  viewBox="0 0 400 300"
  preserveAspectRatio="xMidYMid meet"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="0" y="0" width="400" height="300" fill="#F5F5F7" />

  <!-- zemin çizgisi -->
  <line x1="20" y1="260" x2="380" y2="260" stroke="#111111" stroke-width="1" opacity="0.4" />

  {variant === "residence" ? (
    blocks.map((b) => (
      <g>
        <rect x={b.x} y={b.y} width="80" height={b.h} fill="none" stroke="#111111" stroke-width="1" opacity="0.55" />
        {Array.from({ length: b.floors }).map((_, f) => (
          <line
            x1={b.x}
            y1={b.y + f * 20}
            x2={b.x + 80}
            y2={b.y + f * 20}
            stroke="#111111"
            stroke-width="0.5"
            opacity="0.25"
          />
        ))}
      </g>
    ))
  ) : (
    <g>
      <rect x="60" y="140" width="280" height="100" fill="none" stroke="#111111" stroke-width="1" opacity="0.55" />
      <line x1="60" y1="140" x2="340" y2="140" stroke="#111111" stroke-width="1.5" opacity="0.6" />
      <rect x={90 + offset} y="170" width="60" height="70" fill="none" stroke="#111111" stroke-width="0.75" opacity="0.4" />
      <rect x={220 - offset} y="170" width="90" height="40" fill="none" stroke="#111111" stroke-width="0.75" opacity="0.4" />
      <circle cx="360" cy="212" r="18" fill="none" stroke="#111111" stroke-width="0.75" opacity="0.3" />
      <line x1="360" y1="230" x2="360" y2="260" stroke="#111111" stroke-width="0.75" opacity="0.3" />
    </g>
  )}

  <!-- CAD ölçü tikleri -->
  <line x1="20" y1="255" x2="20" y2="265" stroke="#111111" stroke-width="0.75" opacity="0.4" />
  <line x1="380" y1="255" x2="380" y2="265" stroke="#111111" stroke-width="0.75" opacity="0.4" />
</svg>
