---
import MarbleBackground from '../components/MarbleBackground.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- GOOGLE FONTS -->
		<link rel="preconnect" href="https://googleapis.com">
		<link rel="preconnect" href="https://gstatic.com" crossorigin>
		<link href="https://googleapis.com/css2?family=Archivo:wght@100;200;300;400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#FFFFFF] text-[#111111] antialiased selection:bg-[#111111] selection:text-white">
		<MarbleBackground />
		<slot />
	</body>
</html>

<style is:global>
	/* Tailwind v4 Ana Entegrasyonu */
	@import "tailwindcss";

	body {
		font-family: 'Inter', sans-serif;
	}
	
	h1, h2, h3, .font-mono-arch {
		font-family: 'Archivo', sans-serif;
	}

	main :where(h1, h2, h3, p, a, span) {
		text-shadow: 0 0 2px rgba(255, 255, 255, 0.95), 0 0 16px rgba(255, 255, 255, 0.75);
	}

	img {
		content-visibility: auto;
	}
</style>